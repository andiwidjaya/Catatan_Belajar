# Personal Knowledge Library — Production Environment Variables Example
# Copy this file to .env.local for local development, or configure these variables in Vercel / hosting provider.

# ==========================================
# 1. Supabase Public API Configuration (Exposed to Browser)
# ==========================================
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co

# Your Supabase Anon API Key (Used by client-side Supabase SSR client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# 2. Supabase Server-Only Configuration (Strictly Confidential)
# ==========================================
# Your Supabase Service Role Key (Used strictly on server for admin tasks / migrations if needed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# 3. Google Gemini API Configuration (Strictly Confidential)
# ==========================================
# Your Google Gemini API Key (Obtained from Google AI Studio)
# Used server-side only for structured summarization, item chat, vector embeddings, and RAG Q&A
GEMINI_API_KEY=your-gemini-api-key
